<?xml version="1.0" encoding="UTF-8"?>
<!-- The cluster's wire protocol: the handshake, peer (Raft), client, admin and log-entry messages.
     Every frame is a u32 length and one of these messages. Services' own payloads are opaque
     `payload` bytes here; each service has a schema of its own. Change it only as WIRE.md says:
     old and new nodes run side by side. -->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe" package="wire" id="100" version="8"
                   byteOrder="littleEndian">
    <types>
        <composite name="messageHeader">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>
        <composite name="groupSizeEncoding">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="numInGroup" primitiveType="uint16"/>
        </composite>
        <!-- A service payload: MAX_PAYLOAD_BYTES. -->
        <composite name="payloadData">
            <type name="length" primitiveType="uint32" maxValue="65536"/>
            <type name="varData" primitiveType="uint8" length="0"/>
        </composite>
        <!-- Log records shipped verbatim, or a snapshot chunk: bounded by MAX_FRAME_BYTES. -->
        <composite name="bulkData">
            <type name="length" primitiveType="uint32" maxValue="1048000"/>
            <type name="varData" primitiveType="uint8" length="0"/>
        </composite>
        <composite name="addrData">
            <type name="length" primitiveType="uint8"/>
            <type name="varData" primitiveType="uint8" length="0"/>
        </composite>
        <composite name="tokenData">
            <type name="length" primitiveType="uint8"/>
            <type name="varData" primitiveType="uint8" length="0"/>
        </composite>
        <enum name="Role" encodingType="uint8">
            <validValue name="Peer">1</validValue>
            <validValue name="Client">2</validValue>
            <validValue name="Admin">3</validValue>
        </enum>
        <enum name="CloseReason" encodingType="uint8">
            <validValue name="Client">1</validValue>
            <validValue name="Timeout">2</validValue>
            <validValue name="Service">3</validValue>
            <!-- The cluster has no such session: never opened, or closed. -->
            <validValue name="NoSession">4</validValue>
            <!-- The service didn't accept the credentials. -->
            <validValue name="Refused">5</validValue>
            <!-- The client's own, never sent: the cluster it reattached to has less of the
                 session than it saw (a standby promoted without all of it), so it closed the
                 session. -->
            <validValue name="Diverged">6</validValue>
        </enum>
    </types>

    <!-- Handshake: the first frame each way on every connection. `token`: an operator's, to the
         admin listener of a node that requires one; the cluster's peer token, to a peer, if it has
         one; empty otherwise, and from an older node. `epoch`: the cluster's, as the node knows
         it (0 for not yet, and from a client or operator); peers that know different ones are of
         different clusters, and don't talk. -->
    <sbe:message name="Hello" id="1">
        <field name="magic" id="1" type="uint32"/>
        <field name="serviceId" id="2" type="uint32"/>
        <field name="role" id="3" type="Role"/>
        <field name="nodeId" id="4" type="uint8"/>
        <field name="epoch" id="6" type="uint64"/>
        <data name="token" id="5" type="tokenData" sinceVersion="2"/>
    </sbe:message>
    <!-- The admin listener's answer to a hello without its token, instead of a hello; then it
         closes the connection. An older operator's tool, not knowing it, sees no hello. -->
    <sbe:message name="Unauthorized" id="2">
    </sbe:message>

    <!-- Peer to peer. -->
    <!-- `round`: which of the candidate's pre-votes this is, for the `Vote` to echo. Absent from an
         older node. -->
    <sbe:message name="RequestVote" id="10">
        <field name="term" id="1" type="uint64"/>
        <field name="candidate" id="2" type="uint8"/>
        <field name="lastIndex" id="3" type="uint64"/>
        <field name="lastTerm" id="4" type="uint64"/>
        <field name="preVote" id="5" type="uint8"/>
        <field name="round" id="6" type="uint64" sinceVersion="5"/>
    </sbe:message>
    <!-- `doubt`: the voter's log dropped a damaged tail, which may have held entries it
         acknowledged, and it hasn't caught up since: an election counting its vote needs one more.
         Absent from an older node, which never doubts. `round`: the request's, so a pre-vote
         delayed past the round it answers doesn't count in a later one. Absent from an older node,
         whose pre-vote counts in any round, as before. -->
    <sbe:message name="Vote" id="11">
        <field name="term" id="1" type="uint64"/>
        <field name="granted" id="2" type="uint8"/>
        <field name="preVote" id="3" type="uint8"/>
        <field name="doubt" id="4" type="uint8" sinceVersion="1"/>
        <field name="round" id="5" type="uint64" sinceVersion="5"/>
    </sbe:message>
    <!-- `entries` is `count` log records, as stored. None is a heartbeat. `lastIndex`: the
         leader's, for a follower in doubt to know when it has the leader's whole log, read by
         followers before version 7 only: an append arriving late says less than it acknowledged.
         `readRound`: the leader's latest round of confirming it still leads, for a read
         (`Raft::read_index`), which the ack echoes. Absent from an older leader. -->
    <sbe:message name="AppendEntries" id="12">
        <field name="term" id="1" type="uint64"/>
        <field name="leader" id="2" type="uint8"/>
        <field name="prevIndex" id="3" type="uint64"/>
        <field name="prevTerm" id="4" type="uint64"/>
        <field name="commit" id="5" type="uint64"/>
        <field name="count" id="6" type="uint32"/>
        <field name="lastIndex" id="8" type="uint64" sinceVersion="3"/>
        <field name="readRound" id="9" type="uint64" sinceVersion="8"/>
        <data name="entries" id="7" type="bulkData"/>
    </sbe:message>
    <!-- `index`: the durable last index on success, where to retry from on failure. -->
    <!-- `protocol` and `serviceVersion`: the highest this node's code supports, for the leader to
         know the lowest among the members. `prevIndex`: the `prevIndex` of the append (or the
         `lastIndex` of the snapshot) it answers, so a leader tells a refusal of the append it's
         probing with from one of an older append. `readRound`: the append's, echoed (0 for a
         snapshot's). Absent from an older node. -->
    <sbe:message name="AppendAck" id="13">
        <field name="term" id="1" type="uint64"/>
        <field name="success" id="2" type="uint8"/>
        <field name="index" id="3" type="uint64"/>
        <field name="snapshotIndex" id="4" type="uint64"/>
        <field name="protocol" id="5" type="uint32"/>
        <field name="serviceVersion" id="6" type="uint32"/>
        <field name="prevIndex" id="7" type="uint64" sinceVersion="7"/>
        <field name="readRound" id="8" type="uint64" sinceVersion="8"/>
    </sbe:message>
    <sbe:message name="InstallSnapshot" id="14">
        <field name="term" id="1" type="uint64"/>
        <field name="leader" id="2" type="uint8"/>
        <field name="lastIndex" id="3" type="uint64"/>
        <field name="lastTerm" id="4" type="uint64"/>
        <field name="offset" id="5" type="uint64"/>
        <field name="done" id="6" type="uint8"/>
        <!-- Of the whole snapshot and its members, as the leader's file has it. -->
        <field name="checksum" id="13" type="uint64"/>
        <!-- The members as of `lastIndex`, as in `Members`. -->
        <group name="member" id="8" dimensionType="groupSizeEncoding">
            <field name="id" id="9" type="uint8"/>
            <field name="learner" id="14" type="uint8"/>
            <data name="peer" id="10" type="addrData"/>
            <data name="client" id="11" type="addrData"/>
            <data name="admin" id="12" type="addrData"/>
        </group>
        <data name="chunk" id="7" type="bulkData"/>
    </sbe:message>
    <!-- `index`: of the snapshot it's of. The leader may move on to a newer one while acks of the
         last are in flight. -->
    <sbe:message name="SnapshotAck" id="15">
        <field name="term" id="1" type="uint64"/>
        <field name="offset" id="2" type="uint64"/>
        <field name="index" id="3" type="uint64"/>
    </sbe:message>
    <!-- From a leader handing over to a follower whose log matches its own: stand for election
         now, without a pre-vote. -->
    <sbe:message name="TimeoutNow" id="16">
        <field name="term" id="1" type="uint64"/>
    </sbe:message>
    <!-- From a leader shutting the cluster down: stop, once the snapshot of `index` is durable. -->
    <sbe:message name="Stop" id="17">
        <field name="term" id="1" type="uint64"/>
        <field name="index" id="2" type="uint64"/>
    </sbe:message>

    <!-- Client to cluster. -->
    <!-- `credentials` are the service's to check: see `Service::authenticate`. -->
    <sbe:message name="Connect" id="20">
        <data name="credentials" id="1" type="payloadData"/>
    </sbe:message>
    <!-- The same credentials: they must be the session's principal's. `epoch`: the cluster's, as
         the session's last `Opened` said, or 0 for none. Absent from an older client. -->
    <sbe:message name="Reattach" id="21">
        <field name="session" id="1" type="uint64"/>
        <field name="lastEgressSeq" id="2" type="uint64"/>
        <field name="epoch" id="4" type="uint64" sinceVersion="5"/>
        <data name="credentials" id="3" type="payloadData"/>
    </sbe:message>
    <sbe:message name="Message" id="22">
        <field name="session" id="1" type="uint64"/>
        <field name="clientSeq" id="2" type="uint64"/>
        <data name="payload" id="3" type="payloadData"/>
    </sbe:message>
    <sbe:message name="KeepAlive" id="23">
        <field name="session" id="1" type="uint64"/>
    </sbe:message>
    <sbe:message name="Close" id="24">
        <field name="session" id="1" type="uint64"/>
    </sbe:message>
    <!-- A query of the state as applied, never logged (`Service::on_query`). An older node skips
         it unanswered: every member must be of this version first. `queryId`: the client's, for
         the answer to name. -->
    <sbe:message name="Query" id="25">
        <field name="session" id="1" type="uint64"/>
        <field name="queryId" id="2" type="uint64"/>
        <data name="payload" id="3" type="payloadData"/>
    </sbe:message>

    <!-- Cluster to client (and admin, for Redirect). An empty addr: no leader yet, retry. -->
    <sbe:message name="Redirect" id="30">
        <field name="leader" id="1" type="uint8"/>
        <data name="addr" id="2" type="addrData"/>
    </sbe:message>
    <!-- `lastEgressSeq`: the session's last response. A client that knows of more applied than
         `appliedSeq`, or has seen more responses, has seen what this cluster lost. `epoch`: the
         cluster's, for a `Reattach` to name. Absent from an older node. -->
    <sbe:message name="Opened" id="31">
        <field name="session" id="1" type="uint64"/>
        <field name="appliedSeq" id="2" type="uint64"/>
        <field name="lastEgressSeq" id="3" type="uint64" sinceVersion="4"/>
        <field name="epoch" id="4" type="uint64" sinceVersion="5"/>
    </sbe:message>
    <sbe:message name="Egress" id="32">
        <field name="session" id="1" type="uint64"/>
        <field name="egressSeq" id="2" type="uint64"/>
        <field name="appliedSeq" id="3" type="uint64"/>
        <data name="payload" id="4" type="payloadData"/>
    </sbe:message>
    <sbe:message name="KeepAliveAck" id="33">
        <field name="appliedSeq" id="1" type="uint64"/>
    </sbe:message>
    <sbe:message name="Closed" id="34">
        <field name="session" id="1" type="uint64"/>
        <field name="reason" id="2" type="CloseReason"/>
    </sbe:message>
    <sbe:message name="QueryAnswer" id="35">
        <field name="session" id="1" type="uint64"/>
        <field name="queryId" id="2" type="uint64"/>
        <data name="payload" id="3" type="payloadData"/>
    </sbe:message>
    <!-- `unsupported`: 1 if the service takes no such query, so asking again won't help; 0 if the
         leader is busy: ask again. -->
    <sbe:message name="QueryRefused" id="36">
        <field name="session" id="1" type="uint64"/>
        <field name="queryId" id="2" type="uint64"/>
        <field name="unsupported" id="3" type="uint8"/>
    </sbe:message>

    <!-- Admin. -->
    <sbe:message name="SnapshotRequest" id="40">
        <field name="requestId" id="1" type="uint64"/>
    </sbe:message>
    <sbe:message name="SnapshotTaken" id="41">
        <field name="requestId" id="1" type="uint64"/>
        <field name="index" id="2" type="uint64"/>
        <field name="quorumAcked" id="3" type="uint8"/>
    </sbe:message>
    <!-- Add a member, reached at these addresses: it catches up, then joins; with `learner` 1,
         as a learner, which takes the log but doesn't vote. -->
    <sbe:message name="AddMember" id="42">
        <field name="requestId" id="1" type="uint64"/>
        <field name="id" id="2" type="uint8"/>
        <field name="learner" id="6" type="uint8"/>
        <data name="peer" id="3" type="addrData"/>
        <data name="client" id="4" type="addrData"/>
        <data name="admin" id="5" type="addrData"/>
    </sbe:message>
    <sbe:message name="RemoveMember" id="43">
        <field name="requestId" id="1" type="uint64"/>
        <field name="id" id="2" type="uint8"/>
    </sbe:message>
    <!-- The change is committed, at `index`; or the members were as asked already (a request sent
         again after it was made), as of the latest change, at `index`: or a snapshot since,
         which keeps no index of it. -->
    <sbe:message name="MembersChanged" id="44">
        <field name="requestId" id="1" type="uint64"/>
        <field name="index" id="2" type="uint64"/>
    </sbe:message>
    <!-- Refused: another change is under way, a member has the ID with other addresses or role
         (or none has it, to set its role), there would be too many or none, or a new member
         didn't catch up. -->
    <sbe:message name="MembersRefused" id="45">
        <field name="requestId" id="1" type="uint64"/>
    </sbe:message>
    <!-- Hand the leadership to member `to`, or, with 0, to the one most caught up. -->
    <sbe:message name="TransferLeadership" id="46">
        <field name="requestId" id="1" type="uint64"/>
        <field name="to" id="2" type="uint8"/>
    </sbe:message>
    <!-- `leader` leads now; 0 if the transfer was refused or didn't happen in time. -->
    <sbe:message name="LeadershipTransferred" id="47">
        <field name="requestId" id="1" type="uint64"/>
        <field name="leader" id="2" type="uint8"/>
    </sbe:message>
    <!-- Switch the cluster's protocol, and the service's behaviour, to these versions: refused
         unless every member supports them, and they're no lower than now. -->
    <sbe:message name="Activate" id="70">
        <field name="requestId" id="1" type="uint64"/>
        <field name="protocol" id="2" type="uint32"/>
        <field name="serviceVersion" id="3" type="uint32"/>
    </sbe:message>
    <!-- Activated at `index`, or refused (0); and the lowest versions the members support. -->
    <sbe:message name="Activation" id="71">
        <field name="requestId" id="1" type="uint64"/>
        <field name="index" id="2" type="uint64"/>
        <field name="lowestProtocol" id="3" type="uint32"/>
        <field name="lowestServiceVersion" id="4" type="uint32"/>
    </sbe:message>
    <!-- To a learner, with its cluster lost: make it the one member of a new cluster, of a new
         epoch, from its log as it is. Refused unless it's a learner that hasn't heard a leader
         for an election timeout. -->
    <sbe:message name="Promote" id="72">
        <field name="requestId" id="1" type="uint64"/>
    </sbe:message>
    <!-- Promoted: the new cluster's epoch, logged at `index`; or refused (0). -->
    <sbe:message name="Promoted" id="73">
        <field name="requestId" id="1" type="uint64"/>
        <field name="index" id="2" type="uint64"/>
        <field name="epoch" id="3" type="uint64"/>
    </sbe:message>
    <!-- Make member `id` a learner (`learner` 1) or a voter (0), in place: one change of members,
         answered as `AddMember` is. A learner made a voter catches up first, as a member added
         does. An older leader doesn't answer. -->
    <sbe:message name="SetRole" id="76">
        <field name="requestId" id="1" type="uint64"/>
        <field name="id" id="2" type="uint8"/>
        <field name="learner" id="3" type="uint8"/>
    </sbe:message>
    <!-- To any member, which answers itself: copy its latest snapshot, and its log from there to
         its commit index, into a directory of its data directory, to replay offline. An older
         node doesn't answer. -->
    <sbe:message name="Capture" id="77">
        <field name="requestId" id="1" type="uint64"/>
    </sbe:message>
    <!-- Captured: the entries after `snapshotIndex` (0: none) to `to`, in the directory `detail`
         names on that node; or, `refused` 1, not, and `detail` says why. -->
    <sbe:message name="Captured" id="78">
        <field name="requestId" id="1" type="uint64"/>
        <field name="refused" id="2" type="uint8"/>
        <field name="snapshotIndex" id="3" type="uint64"/>
        <field name="to" id="4" type="uint64"/>
        <data name="detail" id="5" type="payloadData"/>
    </sbe:message>
    <!-- Each member's progress, as the leader knows it. An older leader doesn't answer. -->
    <sbe:message name="StatusRequest" id="74">
        <field name="requestId" id="1" type="uint64"/>
    </sbe:message>
    <!-- From `leader`: the end of its log, its commit index, how far each member's log is known
         durable (`matched`; the leader's own, its last index), and the versions active. -->
    <sbe:message name="Status" id="75">
        <field name="requestId" id="1" type="uint64"/>
        <field name="leader" id="2" type="uint8"/>
        <field name="lastIndex" id="3" type="uint64"/>
        <field name="commitIndex" id="4" type="uint64"/>
        <field name="protocol" id="9" type="uint32" sinceVersion="5"/>
        <field name="serviceVersion" id="10" type="uint32" sinceVersion="5"/>
        <group name="member" id="5" dimensionType="groupSizeEncoding">
            <field name="id" id="6" type="uint8"/>
            <!-- 1: it takes the log but doesn't vote. -->
            <field name="learner" id="7" type="uint8"/>
            <field name="matched" id="8" type="uint64"/>
        </group>
    </sbe:message>
    <!-- Snapshot every node at the next index, then stop them. -->
    <sbe:message name="Shutdown" id="48">
        <field name="requestId" id="1" type="uint64"/>
    </sbe:message>
    <!-- The members have the snapshot of `index` durable, and are stopping. -->
    <sbe:message name="ShutDown" id="49">
        <field name="requestId" id="1" type="uint64"/>
        <field name="index" id="2" type="uint64"/>
    </sbe:message>

    <!-- Log-entry bodies: the payload of a log record. `timestamp` is the leader's clock in ns,
         the only time the service sees. -->
    <!-- The session's ID is this entry's log index; `principal`, who the service said it is. -->
    <sbe:message name="SessionOpen" id="50">
        <field name="timestamp" id="1" type="uint64"/>
        <data name="principal" id="2" type="addrData"/>
    </sbe:message>
    <sbe:message name="SessionMessage" id="51">
        <field name="timestamp" id="1" type="uint64"/>
        <field name="session" id="2" type="uint64"/>
        <field name="clientSeq" id="3" type="uint64"/>
        <data name="payload" id="4" type="payloadData"/>
    </sbe:message>
    <sbe:message name="SessionClose" id="52">
        <field name="timestamp" id="1" type="uint64"/>
        <field name="session" id="2" type="uint64"/>
        <field name="reason" id="3" type="CloseReason"/>
    </sbe:message>
    <sbe:message name="TimerFired" id="53">
        <field name="timestamp" id="1" type="uint64"/>
        <field name="id" id="2" type="uint64"/>
    </sbe:message>
    <sbe:message name="NewTerm" id="54">
        <field name="timestamp" id="1" type="uint64"/>
    </sbe:message>
    <sbe:message name="Snapshot" id="55">
        <field name="timestamp" id="1" type="uint64"/>
        <field name="requestId" id="2" type="uint64"/>
    </sbe:message>
    <!-- From this entry on, the cluster's protocol and the service's behaviour are these versions.
         `egressRing`: from protocol 1, the responses each session keeps, the leader's
         `egress_ring_entries`, for every node; 0, or absent from an older node, for each node's
         own. -->
    <sbe:message name="Activated" id="58">
        <field name="timestamp" id="1" type="uint64"/>
        <field name="protocol" id="2" type="uint32"/>
        <field name="serviceVersion" id="3" type="uint32"/>
        <field name="egressRing" id="4" type="uint32" sinceVersion="5"/>
    </sbe:message>
    <!-- The cluster's epoch from here on: from a new cluster's first leader, which counts only if
         there's none yet (so only the first one applied does); or, with `promoted` 1, from a
         learner promoted to start a cluster of its own, which replaces it. -->
    <sbe:message name="Epoch" id="59">
        <field name="timestamp" id="1" type="uint64"/>
        <field name="epoch" id="2" type="uint64"/>
        <field name="promoted" id="3" type="uint8"/>
    </sbe:message>
    <!-- A service's own message, from `Ctx::propose`: `id` is its place in the outbox. -->
    <sbe:message name="ServiceProposal" id="57">
        <field name="timestamp" id="1" type="uint64"/>
        <field name="id" id="2" type="uint64"/>
        <data name="payload" id="3" type="payloadData"/>
    </sbe:message>
    <!-- The cluster's members from this entry on, taking effect on each node as it appends it. -->
    <sbe:message name="Members" id="56">
        <field name="timestamp" id="1" type="uint64"/>
        <group name="member" id="2" dimensionType="groupSizeEncoding">
            <field name="id" id="3" type="uint8"/>
            <!-- 1: it takes the log but doesn't vote. -->
            <field name="learner" id="7" type="uint8"/>
            <data name="peer" id="4" type="addrData"/>
            <data name="client" id="5" type="addrData"/>
            <data name="admin" id="6" type="addrData"/>
        </group>
    </sbe:message>

    <!-- A snapshot's contents, each message framed as on the wire: NodeState; then, for each
         session, its SessionState and its ring's EgressStates; then each TimerState; then each
         ProposalState. The service's own bytes follow, and the file ends with SnapshotMembers. A
         node must be able to read all of it: see WIRE.md. -->
    <sbe:message name="NodeState" id="60">
        <field name="applied" id="1" type="uint64"/>
        <field name="time" id="2" type="uint64"/>
        <field name="nextProposal" id="3" type="uint64"/>
        <field name="sessions" id="4" type="uint32"/>
        <field name="timers" id="5" type="uint64"/>
        <field name="proposals" id="6" type="uint64"/>
        <field name="protocol" id="7" type="uint32"/>
        <field name="serviceVersion" id="8" type="uint32"/>
        <field name="epoch" id="9" type="uint64"/>
        <!-- The index `epoch` began at: a session opened from it on is this epoch's. Absent from
             an older node, which didn't keep it: then every session is taken for any epoch's. -->
        <field name="epochSince" id="10" type="uint64" sinceVersion="5"/>
        <!-- The responses each session keeps, as last activated: 0, or absent from an older node,
             for each node's own `egress_ring_entries`. -->
        <field name="egressRing" id="11" type="uint32" sinceVersion="5"/>
    </sbe:message>
    <!-- `ring` EgressStates follow it. -->
    <sbe:message name="SessionState" id="61">
        <field name="session" id="1" type="uint64"/>
        <field name="lastSeq" id="2" type="uint64"/>
        <field name="nextEgress" id="3" type="uint64"/>
        <field name="ring" id="4" type="uint32"/>
        <!-- A session carried over into the epoch from an earlier one (promoted or restored from):
             its last `clientSeq` applied and its last `egressSeq` as the epoch began, against
             which a client of the earlier epoch reattaching is judged. `u64::MAX` for one opened
             in this epoch; absent from an older node, which didn't keep them. -->
        <field name="carriedSeq" id="6" type="uint64" sinceVersion="6"/>
        <field name="carriedEgress" id="7" type="uint64" sinceVersion="6"/>
        <data name="principal" id="5" type="addrData"/>
    </sbe:message>
    <sbe:message name="EgressState" id="62">
        <field name="egressSeq" id="1" type="uint64"/>
        <data name="payload" id="2" type="payloadData"/>
    </sbe:message>
    <sbe:message name="TimerState" id="63">
        <field name="id" id="1" type="uint64"/>
